<div style="margin-bottom: 20px;">
    <h3>Авторизація</h3>
    <form method="post" action="%address%">
        <div style="margin-bottom: 8px;">
            <input type="text" name="login" placeholder="Логін" style="width: 100%; padding: 6px; box-sizing: border-box;">
        </div>
        <div style="margin-bottom: 8px;">
            <input type="password" name="password" placeholder="Пароль" style="width: 100%; padding: 6px; box-sizing: border-box;">
        </div>
        <button type="submit" style="padding: 6px 12px; background: #2563eb; color: #fff; border: none; border-radius: 4px; cursor: pointer;">Увійти</button>
    </form>
</div>